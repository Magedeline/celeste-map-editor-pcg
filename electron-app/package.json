{
  "name": "celeste-map-editor",
  "version": "1.0.0",
  "description": "Celeste PCG Map Editor — Standalone Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^35.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.celeste.map-editor",
    "productName": "Celeste Map Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "mapBinary.js",
      "luaBridge.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "extraResources": [
      {
        "from": "../cpp/build/celeste_pcg_generator.exe",
        "to": "generator/celeste_pcg_generator.exe"
      },
      {
        "from": "../lua_libs/luajit/bin",
        "to": "luajit"
      },
      {
        "from": "../lua_libs/dkjson",
        "to": "lua_libs/dkjson"
      },
      {
        "from": "../lua_libs/lua-yaml",
        "to": "lua_libs/lua-yaml"
      },
      {
        "from": "../lua_libs/luafilesystem",
        "to": "lua_libs/luafilesystem"
      },
      {
        "from": "../lua_libs/luajit-request",
        "to": "lua_libs/luajit-request"
      },
      {
        "from": "../lua_libs/Selene",
        "to": "lua_libs/Selene"
      },
      {
        "from": "../lua_libs/xml2lua",
        "to": "lua_libs/xml2lua"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
