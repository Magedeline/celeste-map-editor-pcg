<?xml version="1.0" encoding="utf-8"?>
<project>
  <name>Celeste Maps</name>
  <description>Converted Celeste Mod Maps</description>
  <defaultWidth>320</defaultWidth>
  <defaultHeight>180</defaultHeight>
  <defaultExportMode>XML</defaultExportMode>
  
  <!-- Color definitions for editors -->
  <colorDefinitions>
    <color name="Player" value="FF0000"/>
    <color name="Solid" value="888888"/>
    <color name="Air" value="TRANSPARENT"/>
    <color name="Entity" value="00FF00"/>
  </colorDefinitions>
  
  <!-- Tilesets -->
  <tilesets>
    <tileset id="solids" label="Solids" path="">
      <size width="8" height="8"/>
    </tileset>
    <tileset id="bg" label="Background" path="">
      <size width="8" height="8"/>
    </tileset>
    <tileset id="objtiles" label="Object Tiles" path="">
      <size width="8" height="8"/>
    </tileset>
    <tileset id="bgtiles" label="BG Tiles" path="">
      <size width="8" height="8"/>
    </tileset>
  </tilesets>
  
  <!-- Layers -->
  <layers>
    <layer id="bg" name="Background" type="tile" tileset="bg"/>
    <layer id="solids" name="Solids" type="tile" tileset="solids"/>
    <layer id="objtiles" name="Object Tiles" type="tile" tileset="objtiles"/>
    <layer id="bgtiles" name="BG Tiles" type="tile" tileset="bgtiles"/>
    <layer id="entities" name="Entities" type="entity"/>
    <layer id="decals" name="Decals" type="decal"/>
  </layers>
  
  <!-- Entity definitions -->
  <entities>
    <entity name="player" limit="1" width="8" height="8" color="FF0000" resizable="false" rotatable="false"/>
    <entity name="introCar" limit="-1" width="48" height="48" color="FF8800" resizable="false" rotatable="false"/>
    <entity name="lamp" limit="-1" width="8" height="16" color="FFFF00" resizable="false" rotatable="false"/>
    <entity name="wire" limit="-1" width="8" height="8" color="00FF00" resizable="false" rotatable="false"/>
    <entity name="spring" limit="-1" width="12" height="8" color="00FFFF" resizable="false" rotatable="false"/>
    <entity name="spike" limit="-1" width="8" height="8" color="FF00FF" resizable="false" rotatable="false"/>
    <entity name="chest" limit="-1" width="16" height="16" color="8800FF" resizable="false" rotatable="false"/>
    <entity name="strawberry" limit="-1" width="8" height="8" color="FF0088" resizable="false" rotatable="false"/>
    <entity name="cassette" limit="-1" width="16" height="16" color="00FF88" resizable="false" rotatable="false"/>
    <entity name="heartGem" limit="-1" width="12" height="12" color="FF88FF" resizable="false" rotatable="false"/>
    <entity name="crumbleWall" limit="-1" width="8" height="8" color="888888" resizable="true" rotatable="false"/>
    <entity name="cloud" limit="-1" width="32" height="32" color="CCCCCC" resizable="false" rotatable="false"/>
    <entity name="platforms" limit="-1" width="32" height="8" color="AA0000" resizable="true" rotatable="false"/>
    <entity name="hazard" limit="-1" width="8" height="8" color="FF0000" resizable="false" rotatable="false"/>
  </entities>
  
  <!-- Decal definitions -->
  <decals/>
</project>
