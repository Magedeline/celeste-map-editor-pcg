{
  "name": "celeste-map-editor",
  "displayName": "Celeste Map Editor",
  "description": "A visual tile map editor for Celeste (.bin map files) inside VS Code",
  "version": "0.1.0",
  "publisher": "maggy-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maggy-Studio/celeste-map-editor-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "celeste",
    "map editor",
    "tile editor",
    "level editor",
    "game development"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "celesteMapEditor.mapView",
        "displayName": "Celeste Map Editor",
        "selector": [
          {
            "filenamePattern": "*.bin"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "celesteMapEditor.newMap",
        "title": "Celeste: New Map"
      },
      {
        "command": "celesteMapEditor.exportJson",
        "title": "Celeste: Export Map as JSON"
      },
      {
        "command": "celesteMapEditor.exportCompatibilityBundle",
        "title": "Celeste: Export Lönn + MonoGame Compatibility Bundle"
      },
      {
        "command": "celesteMapEditor.generateRoomCluster",
        "title": "Celeste: Generate Room Cluster"
      },
      {
        "command": "celesteMapEditor.addRoom",
        "title": "Celeste: Add Room"
      }
    ],
    "configuration": {
      "title": "Celeste Map Editor",
      "properties": {
        "celesteMapEditor.celestePath": {
          "type": "string",
          "default": "",
          "description": "Path to Celeste installation directory (for loading tilesets)"
        },
        "celesteMapEditor.gridSize": {
          "type": "number",
          "default": 8,
          "description": "Tile grid size in pixels"
        },
        "celesteMapEditor.showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Show the tile grid overlay"
        },
        "celesteMapEditor.defaultRoomWidth": {
          "type": "number",
          "default": 320,
          "description": "Default width for new rooms (pixels)"
        },
        "celesteMapEditor.defaultRoomHeight": {
          "type": "number",
          "default": 184,
          "description": "Default height for new rooms (pixels)"
        },
        "celesteMapEditor.loennModulePrefix": {
          "type": "string",
          "default": "CelesteMapEditor",
          "description": "Module prefix used when generating Lönn Lua stubs for un-namespaced entities and triggers"
        },
        "celesteMapEditor.monoGameNamespace": {
          "type": "string",
          "default": "CelesteMapEditor.Interop",
          "description": "C# namespace used when generating MonoGame and MonoGame.Extended DTO models"
        },
        "celesteMapEditor.loennPluginPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an existing Lonn plugin folder. Lua files found there override generated compatibility stubs during export."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "build:native": "node ./scripts/build-native.js",
    "publish:pcg-launcher": "node ./scripts/publish-pcg-launcher.js",
    "package:pcg-launcher": "node ./scripts/package-pcg-launcher.js",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src --ext ts",
    "lint:md": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\"",
    "test": "node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "markdownlint-cli2": "^0.22.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "pcg-random": "^2.0.1"
  }
}
